name: "📬 APNs 推送修复"
desc: "APNs 使用独立策略组；与 Rules 策略分流共用时，按已验证顺序将 APNs 放在 Rules 上方"
icon: "https://raw.githubusercontent.com/TsingRiver/stash-apns/main/apns-icon.png"
category: "APNs"

# Append after Rules groups to make referenced groups available first.
proxy-groups: #!append
  - name: "📬 APNs"
    type: select
    icon: "https://raw.githubusercontent.com/TsingRiver/stash-apns/main/apns-icon.png"
    proxies:
      - "自动选择"
      - "节点选择"
      - "全部节点"
      - "即时通讯"
      - "美国节点"
      - "香港节点"
      - "日本节点"
      - "新加坡节点"
      - "台湾节点"
      - "英国节点"
      - "马来西亚节点"
      - "澳洲节点"
      - "阿根廷节点"
      - "DIRECT"

rules:
  - DOMAIN-SUFFIX,push.apple.com,📬 APNs
  - DOMAIN-SUFFIX,akadns.net,📬 APNs
  - DOMAIN-KEYWORD,apple.com.edgekey.net,📬 APNs
  - IP-CIDR,17.249.0.0/16,📬 APNs,no-resolve
  - IP-CIDR,17.252.0.0/16,📬 APNs,no-resolve
  - IP-CIDR,17.57.144.0/22,📬 APNs,no-resolve
  - IP-CIDR,17.188.128.0/18,📬 APNs,no-resolve
  - IP-CIDR,17.188.20.0/23,📬 APNs,no-resolve
  - IP-CIDR6,2620:149:a44::/48,📬 APNs,no-resolve
  - IP-CIDR6,2403:300:a42::/48,📬 APNs,no-resolve
  - IP-CIDR6,2403:300:a51::/48,📬 APNs,no-resolve
  - IP-CIDR6,2a01:b740:a42::/48,📬 APNs,no-resolve
